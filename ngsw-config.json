{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/service-worker.js",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    } 
  ],
  "dataGroups": [
    {
      "name": "api-cementerios",
      "urls": ["/api/cementerios"],
      "cacheConfig": {
        "maxSize": 5,
        "maxAge": "1h",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-informacion",
      "urls": ["/api/fallecidos/sugerencias-nombres"],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "10m",
        "strategy": "freshness"
      }
    }
  ]
}